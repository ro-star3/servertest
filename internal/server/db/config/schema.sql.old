CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    baomain_data TEXT,
    username_lowercase TEXT NOT NULL UNIQUE,
    is_admin BOOLEAN NOT NULL DEFAULT FALSE
);

CREATE TABLE IF NOT EXISTS players (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL UNIQUE,
    name TEXT NOT NULL,
    best_score INTEGER NOT NULL DEFAULT 0,
    color INTEGER NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

CREATE TABLE IF NOT EXISTS bans (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    banned_user_id INTEGER REFERENCES users(id),
    banned_ip_address TEXT,
    admin_user_id INTEGER NOT NULL REFERENCES users(id),
    reason TEXT,
    expires_at TIMESTAMP,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- NEW: Table to store friendships
CREATE TABLE IF NOT EXISTS friendships (
    user_one_id INTEGER NOT NULL REFERENCES users(id),
    user_two_id INTEGER NOT NULL REFERENCES users(id),
    status TEXT NOT NULL, -- 'pending', 'accepted', 'blocked'
    action_user_id INTEGER NOT NULL REFERENCES users(id),
    PRIMARY KEY (user_one_id, user_two_id)
);

CREATE INDEX IF NOT EXISTS idx_bans_banned_user_id ON bans (banned_user_id);
CREATE INDEX IF NOT EXISTS idx_bans_banned_ip_address ON bans (banned_ip_address);